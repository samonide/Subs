{
  "name": "subtitle-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Subtitle generation and editing core. Phase 2: playback and time base.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:server": "tsc --build && node dist/src/server/main.js",
    "dev:web": "vite",
    "build": "tsc --build && vite build",
    "clean": "tsc --build --clean && rm -rf dist coverage",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.1",
    "vitest": "^4.0.14"
  }
}
